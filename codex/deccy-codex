#!/bin/sh
# Start a deccy role in Codex, or complete the child registration handshake.
#
# Usage:
#   deccy-codex plan [codex args...]           # planner root session
#   deccy-codex orchestrator [codex args...]   # orchestrator root session
#   deccy-codex register <task_name>           # child handshake (run by a spawned child)
#
# The launcher sets DECCY_ROLE, DECCY_BUNDLE, DECCY_SKILLS, DECCY_BIN, DECCY_AGENT_ROOT and
# DECCY_STATE, then loads codex/roles/<role>.md as Codex developer_instructions. A spawned child
# runs `deccy-codex register <task_name>` first; the PreToolUse guard binds its agent_id to the role
# named by the task-name prefix.
set -eu

SELF=$0
# Resolve a bare command name through PATH, then follow the symlink into the bundle.
case "$SELF" in
  */*) ;;
  *) SELF=$(command -v "$SELF" 2>/dev/null || printf '%s\n' "$SELF");;
esac
if command -v python3 >/dev/null 2>&1; then
  SELF=$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$SELF")
fi
HERE=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
BUNDLE=$(CDPATH= cd -- "$HERE/.." && pwd)

usage() {
  sed -n '2,12p' "$SELF"
}

if [ $# -eq 0 ]; then
  usage >&2
  exit 2
fi

MODE=$1
shift

case "$MODE" in
  plan|orchestrator)
    ROLE="deccy-$MODE"
    ;;
  register)
    [ $# -eq 1 ] || { echo "deccy-codex register needs exactly one task name" >&2; exit 2; }
    TASK=$1
    case "$TASK" in
      *[!A-Za-z0-9_-]*) echo "deccy-codex: invalid task name '$TASK'" >&2; exit 2;;
    esac
    case "$TASK" in
      deccy_plan_?*|deccy_gate_author_?*|deccy_drafter_?*|deccy_judge_?*) ;;
      *) echo "deccy-codex: task name '$TASK' has no deccy role prefix" >&2; exit 2;;
    esac
    echo "deccy-codex: registered $TASK"
    exit 0
    ;;
  -h|--help|help)
    usage
    exit 0
    ;;
  *)
    echo "unknown mode: $MODE (see --help)" >&2
    exit 2
    ;;
esac

ROLE_FILE="$BUNDLE/codex/roles/$ROLE.md"
[ -f "$ROLE_FILE" ] || { echo "deccy-codex: missing role file $ROLE_FILE" >&2; exit 1; }
command -v codex >/dev/null 2>&1 || {
  echo "deccy-codex: codex is not on PATH (install Codex CLI first)" >&2
  exit 1
}
command -v python3 >/dev/null 2>&1 || {
  echo "deccy-codex: python3 is required (role prompt and guard hook)" >&2
  exit 1
}
command -v jj >/dev/null 2>&1 || echo "deccy-codex: warning: jj is not on PATH" >&2
command -v deccy >/dev/null 2>&1 || echo "deccy-codex: warning: deccy is not on PATH" >&2

AGENT_ROOT="${DECCY_AGENT_ROOT:-$HOME/.local/share/deccy/agent}"
SKILLS_ROOT="${DECCY_SKILLS:-$HOME/.agents/skills}"
STATE_ROOT="${DECCY_STATE:-$AGENT_ROOT/state}"

# Codex's workspace-write sandbox protects `.git`, and jj stores graph changes in `.git/objects`
# and `.jj`. Add the repository root and those two directories as writable roots, or `deccy new`
# and every landing fail with "Operation not permitted". The guard still scopes writes by role.
REPO_ROOT=$(pwd)
if command -v jj >/dev/null 2>&1; then
  JJ_ROOT=$(jj root 2>/dev/null || true)
  [ -n "$JJ_ROOT" ] && REPO_ROOT=$JJ_ROOT
fi
WRITABLE_ROOTS=$(python3 - "$REPO_ROOT" <<'PY'
import json
import os
import sys

root = os.path.abspath(sys.argv[1])
roots = [root]
for name in (".git", ".jj"):
    path = os.path.join(root, name)
    if os.path.isdir(path):
        roots.append(path)
print(json.dumps(roots))
PY
)

# The launcher is trusted; make the writable roots before the guard starts narrowing.
mkdir -p "$AGENT_ROOT/plan" "$AGENT_ROOT/rounds" "$AGENT_ROOT/workspaces/drafts" \
         "$AGENT_ROOT/workspaces/judge" "$STATE_ROOT"

export DECCY_ROLE="$ROLE"
export DECCY_BUNDLE="$BUNDLE"
export DECCY_BIN="$SELF"
export DECCY_AGENT_ROOT="$AGENT_ROOT"
export DECCY_SKILLS="$SKILLS_ROOT"
export DECCY_STATE="$STATE_ROOT"

# Render the role prompt as a TOML basic string (`-c developer_instructions=...`).
DEV_INSTR=$(python3 - "$ROLE_FILE" <<'PY'
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as f:
    text = f.read()

out = ['"']
for ch in text:
    if ch == "\\":
        out.append("\\\\")
    elif ch == '"':
        out.append('\\"')
    elif ch == "\n":
        out.append("\\n")
    elif ch == "\r":
        out.append("\\r")
    elif ch == "\t":
        out.append("\\t")
    elif ord(ch) < 0x20:
        out.append("\\u%04x" % ord(ch))
    else:
        out.append(ch)
out.append('"')
print("".join(out))
PY
)

if [ "$ROLE" = "deccy-plan" ]; then
  exec codex -c features.multi_agent=false \
    -c "developer_instructions=$DEV_INSTR" \
    -c "sandbox_workspace_write.writable_roots=$WRITABLE_ROOTS" \
    --sandbox workspace-write --ask-for-approval never \
    --add-dir "$AGENT_ROOT" "$@"
else
  exec codex -c features.multi_agent=true \
    -c "developer_instructions=$DEV_INSTR" \
    -c "sandbox_workspace_write.writable_roots=$WRITABLE_ROOTS" \
    --sandbox workspace-write --ask-for-approval never \
    --add-dir "$AGENT_ROOT" "$@"
fi
